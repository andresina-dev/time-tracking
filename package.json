{
  "name": "time-tracking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev:accounts & npm run dev:api & npm run dev:frontend & wait",
    "dev:accounts": "tsx apps/accounts/src/server.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:frontend": "vite --config apps/frontend/vite.config.ts",
    "migrate:sqlite": "tsx --experimental-sqlite scripts/migrate-sqlite-to-mysql.ts",
    "build": "tsc -b",
    "test": "vitest run",
    "start": "node apps/api/dist/server.js",
    "start:accounts": "node apps/accounts/dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "fastify": "^4.29.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^4.5.5",
    "vitest": "^3.0.5"
  }
}
